DB_USER=oficina
DB_PASSWORD=oficina
DB_NAME=oficina_db
DATABASE_URL=postgresql://oficina:oficina@localhost:5432/oficina_db
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
NODE_ENV=development
WEBHOOK_SECRET=change-me
SONAR_TOKEN=<your-sonar-token>
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-os-events
OUTBOX_PUBLISH_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_PUBLISHER_ENABLED=true
SQS_QUEUE_URL=http://localhost:4566/000000000000/oficina-os-queue
SQS_CONSUMER_ENABLED=true
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_MESSAGES=10
AWS_ENDPOINT_URL=http://localhost:4566
SAGA_TIMEOUT_ENABLED=true
SAGA_TIMEOUT_INTERVAL_MS=30000
# Timeout por passo da saga (ms); default 3600000 (1h), APROVAR_ORCAMENTO 86400000 (24h).
# Passos: ABRIR_OS, GERAR_ORCAMENTO, APROVAR_ORCAMENTO, EXECUTAR, COBRAR, CONFIRMAR
# SAGA_TIMEOUT_<PASSO>_MS=3600000
# SAGA_TIMEOUT_APROVAR_ORCAMENTO_MS=86400000
