{
  "name": "Oficina — Tech Challenge Fase 4",
  "variables": [
    {
      "name": "correlationId",
      "title": "correlationId",
      "type": "STRING",
      "isMultiSelection": false,
      "replacementStrategy": "STRING",
      "defaultValues": [
        {
          "value": {
            "string": "67c027fe-6951-4918-a46f-ed84810f8484"
          }
        }
      ],
      "nrqlQuery": null,
      "items": null
    }
  ],
  "description": "Painéis exigidos pelos PDFs das Fases 3 e 4 (OS, saúde, saga e mensageria entre os 3 serviços). Importar em New Relic → Dashboards → Import dashboard, e trocar ACCOUNT_ID pelo id da conta.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Ordens de Serviço",
      "description": "Painéis nominalmente exigidos pelo PDF",
      "widgets": [
        {
          "title": "Volume diário de ordens de serviço",
          "layout": { "column": 1, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [8510401],
                "query": "SELECT count(*) AS 'OS abertas' FROM Log WHERE service = 'oficina-api' AND req.method = 'POST' AND req.url = '/os' AND res.statusCode = 201 TIMESERIES 1 day SINCE 30 days ago"
              }
            ]
          }
        },
        {
          "title": "Tempo médio por status (minutos)",
          "layout": { "column": 5, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [8510401],
                "query": "SELECT average(duracaoSegundos) / 60 AS 'Minutos' FROM Log WHERE event = 'os.status.transicao' FACET statusAnterior SINCE 7 days ago"
              }
            ]
          }
        },
        {
          "title": "Erros e falhas nas integrações",
          "layout": { "column": 9, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [8510401],
                "query": "SELECT count(*) FROM Log WHERE event IN ('os.processamento.falha', 'requisicao.falha') FACET event TIMESERIES 1 hour SINCE 24 hours ago"
              }
            ]
          }
        },
        {
          "title": "Transições de status ao longo do tempo",
          "layout": { "column": 1, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [8510401],
                "query": "SELECT count(*) FROM Log WHERE event = 'os.status.transicao' FACET statusNovo TIMESERIES 1 hour SINCE 24 hours ago"
              }
            ]
          }
        },
        {
          "title": "Falhas recentes (com correlationId para investigar)",
          "layout": { "column": 7, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [8510401],
                "query": "SELECT timestamp, correlationId, url, statusCode, `exception.message` FROM Log WHERE event IN ('os.processamento.falha', 'requisicao.falha') LIMIT 50 SINCE 24 hours ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Saúde da aplicação",
      "description": "Latência, erros e infraestrutura",
      "widgets": [
        {
          "title": "Latência das APIs (p50 / p95 / p99)",
          "layout": { "column": 1, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [8510401],
                "query": "SELECT percentile(duration, 50, 95, 99) FROM Transaction WHERE appName LIKE 'oficina-api%' TIMESERIES SINCE 6 hours ago"
              }
            ]
          }
        },
        {
          "title": "Requisições por status HTTP",
          "layout": { "column": 7, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [8510401],
                "query": "SELECT count(*) FROM Log WHERE service = 'oficina-api' AND res.statusCode IS NOT NULL FACET res.statusCode TIMESERIES 5 minutes SINCE 3 hours ago"
              }
            ]
          }
        },
        {
          "title": "Rotas mais lentas",
          "layout": { "column": 1, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [8510401],
                "query": "SELECT average(responseTime) FROM Log WHERE service = 'oficina-api' AND responseTime IS NOT NULL FACET req.url SINCE 6 hours ago LIMIT 10"
              }
            ]
          }
        },
        {
          "title": "CPU e memória dos pods",
          "layout": { "column": 7, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [8510401],
                "query": "SELECT average(cpuUsedCores) AS 'CPU (cores)', average(memoryWorkingSetBytes) / 1e6 AS 'Memória (MB)' FROM K8sContainerSample WHERE containerName = 'oficina-os-service' TIMESERIES SINCE 3 hours ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Saga e mensageria",
      "description": "Saga orquestrada pelo OS entre OS, Billing e Execução: passos, desfechos, filas SQS e rastreamento por correlationId",
      "widgets": [
        {
          "title": "Passos da saga por estado",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8510401
                ],
                "query": "FROM Log SELECT count(*) WHERE event = 'saga.passo.transicao' AND container_name = 'oficina-os-service' FACET passo, statusNovo SINCE 24 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Desfecho das sagas",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8510401
                ],
                "query": "FROM Log SELECT count(*) WHERE event = 'saga.status' AND container_name = 'oficina-os-service' FACET statusNovo TIMESERIES 1 hour SINCE 24 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Profundidade das DLQs",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8510401
                ],
                "query": "FROM Metric SELECT max(aws.sqs.ApproximateNumberOfMessagesVisible) WHERE aws.sqs.QueueName LIKE '%dlq' FACET aws.sqs.QueueName TIMESERIES SINCE 6 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Backlog das filas principais",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8510401
                ],
                "query": "FROM Metric SELECT max(aws.sqs.ApproximateNumberOfMessagesVisible) WHERE aws.sqs.QueueName NOT LIKE '%dlq' AND aws.sqs.QueueName LIKE 'oficina-%' FACET aws.sqs.QueueName TIMESERIES SINCE 6 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Rastreamento por correlationId (3 serviços)",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 12,
            "height": 4
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8510401
                ],
                "query": "FROM Log SELECT timestamp, container_name, message WHERE allColumnSearch({{correlationId}}) AND container_name IS NOT NULL SINCE 1 day ago LIMIT 200"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Volume de logs por serviço",
          "layout": {
            "column": 1,
            "row": 11,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8510401
                ],
                "query": "FROM Log SELECT count(*) WHERE namespace_name = 'prod' FACET container_name TIMESERIES SINCE 6 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "CPU e memória dos 3 serviços",
          "layout": {
            "column": 7,
            "row": 11,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8510401
                ],
                "query": "FROM K8sContainerSample SELECT average(cpuUsedCores) AS 'CPU (cores)', average(memoryWorkingSetBytes) / 1e6 AS 'Memória (MB)' WHERE containerName IN ('oficina-os-service', 'oficina-billing-service', 'oficina-execucao-service') FACET containerName TIMESERIES SINCE 3 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        }
      ]
    }
  ]
}
