// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StatusOS {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  APROVADA
  REPROVADA
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
}

enum TipoDocumento {
  CPF
  CNPJ
}

// ---------------------------------------------------------------------------
// Cadastros
// ---------------------------------------------------------------------------

model Cliente {
  id            String        @id @default(uuid())
  nome          String
  documento     String        @unique
  tipoDocumento TipoDocumento @map("tipo_documento")
  telefone      String?
  email         String?
  endereco      String?
  ativo         Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  veiculos        Veiculo[]
  ordensDeServico OrdemDeServico[]

  @@map("clientes")
}

model Veiculo {
  id        String   @id @default(uuid())
  clienteId String   @map("cliente_id")
  placa     String   @unique
  marca     String
  modelo    String
  ano       Int?
  cor       String?
  kmAtual   Int?     @map("km_atual")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cliente         Cliente          @relation(fields: [clienteId], references: [id])
  ordensDeServico OrdemDeServico[]

  @@map("veiculos")
}

// ---------------------------------------------------------------------------
// Ordem de Serviço
// ---------------------------------------------------------------------------

model OrdemDeServico {
  id                String    @id @default(uuid())
  numero            String    @unique
  clienteId         String    @map("cliente_id")
  veiculoId         String    @map("veiculo_id")
  status            StatusOS  @default(RECEBIDA)
  arquivada         Boolean   @default(false)
  descricaoProblema String?   @map("descricao_problema")
  dataAbertura      DateTime  @default(now()) @map("data_abertura")
  dataFechamento    DateTime? @map("data_fechamento")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  cliente         Cliente             @relation(fields: [clienteId], references: [id])
  veiculo         Veiculo             @relation(fields: [veiculoId], references: [id])
  osItensServico  OsItemServico[]
  osItensPeca     OsItemPeca[]
  historicoStatus HistoricoStatusOS[]

  @@map("ordens_de_servico")
}

/// Trilha de transições de status da OS. Alimenta o acompanhamento exposto ao
/// cliente e a métrica de tempo médio por status (ver docs/observabilidade).
model HistoricoStatusOS {
  id             String    @id @default(uuid())
  osId           String    @map("os_id")
  statusAnterior StatusOS? @map("status_anterior")
  statusNovo     StatusOS  @map("status_novo")
  data           DateTime  @default(now())

  os OrdemDeServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  @@index([osId, data])
  @@map("historico_status_os")
}

model OsItemServico {
  id            String    @id @default(uuid())
  osId          String    @map("os_id")
  servicoId     String    @map("servico_id")
  precoUnitario Decimal   @map("preco_unitario") @db.Decimal(10, 2)
  inicioExec    DateTime? @map("inicio_exec")
  fimExec       DateTime? @map("fim_exec")
  createdAt     DateTime  @default(now()) @map("created_at")

  os OrdemDeServico @relation(fields: [osId], references: [id])

  @@map("os_itens_servico")
}

model OsItemPeca {
  id            String   @id @default(uuid())
  osId          String   @map("os_id")
  pecaId        String   @map("peca_id")
  quantidade    Int
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  utilizada     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  os OrdemDeServico @relation(fields: [osId], references: [id])

  @@map("os_itens_peca")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  ATENDENTE
  MECANICO
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  refreshTokenHash String?
  role             UserRole @default(ATENDENTE)
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Outbox
// ---------------------------------------------------------------------------

model Outbox {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  evento        String
  payload       Json
  correlationId String    @map("correlation_id")
  traceparent   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  tentativas    Int       @default(0)
  ultimoErro    String?   @map("ultimo_erro") @db.Text

  @@index([publishedAt, createdAt])
  @@map("outbox")
}
